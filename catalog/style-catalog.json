        "pattern": "solid"
      }
    }
  },
  "roles": [
    {
      "id": "legal.document_title",
      "label": "Título del documento",
      "description": "Identifica el documento normativo o material de estudio completo.",
      "applies_to": [
        "topic"
      ],
      "when_to_use": [
        "Título oficial o nombre principal del documento."
      ],
      "when_not_to_use": [
        "Título de una división interna o de un artículo."
      ],
      "style_ref": "legal.document-title",
      "examples": {
        "positive": [
          "Ley 39/2015, de 1 de octubre"
        ],
        "negative": [
          "Artículo 14. Igualdad ante la ley"
        ]
      }
    },
    {
      "id": "legal.book",
      "label": "Libro",
      "description": "División normativa de nivel libro.",
      "applies_to": [
        "topic"
      ],
      "when_to_use": [
        "La fuente identifica expresamente una división como libro."
      ],
      "when_not_to_use": [
        "Títulos, capítulos o artículos."
      ],
      "style_ref": "legal.hierarchy"
    },
    {
      "id": "legal.part",
      "label": "Parte",
      "description": "División normativa denominada parte.",
      "applies_to": [
        "topic"
      ],
      "when_to_use": [
        "La fuente contiene una parte formal."
      ],
      "when_not_to_use": [
        "Un bloque editorial añadido para organizar apuntes."
      ],
      "style_ref": "legal.hierarchy"
    },
    {
      "id": "legal.title",
      "label": "Título",
      "description": "División normativa formal denominada título.",
      "applies_to": [
        "topic"
      ],
      "when_to_use": [
        "La numeración o rótulo de la fuente identifica un título."
      ],
      "when_not_to_use": [
        "El título informal de un tema o documento."
      ],
      "style_ref": "legal.hierarchy"
    },
    {
      "id": "legal.chapter",
      "label": "Capítulo",
      "description": "División normativa formal denominada capítulo.",
      "applies_to": [
        "topic"
      ],
      "when_to_use": [
        "La fuente identifica un capítulo."
      ],
      "when_not_to_use": [
        "Un grupo de apuntes sin correspondencia normativa."
      ],
      "style_ref": "legal.hierarchy"
    },
    {
      "id": "legal.section",
      "label": "Sección",
      "description": "División normativa formal denominada sección.",
      "applies_to": [
        "topic"
      ],
      "when_to_use": [
        "La fuente identifica una sección."
      ],
      "when_not_to_use": [
        "Un apartado o párrafo numerado."
      ],
      "style_ref": "legal.hierarchy"
    },
    {
      "id": "legal.article",
      "label": "Artículo",
      "description": "Unidad normativa identificada como artículo, conservando su número y rúbrica.",
      "applies_to": [
        "topic"
      ],
      "when_to_use": [
        "La fuente contiene un artículo normativo identificable."
      ],
      "when_not_to_use": [
        "Una explicación o resumen propio sobre el artículo."
      ],
      "style_ref": "legal.article"
    },
    {
      "id": "legal.paragraph",
      "label": "Apartado",
      "description": "Unidad subordinada de un artículo, normalmente numerada o identificada como apartado.",
      "applies_to": [
        "topic"
      ],
      "when_to_use": [
        "La fuente presenta un apartado dentro de un artículo."
      ],
      "when_not_to_use": [
        "Una frase o párrafo sin identidad estructural independiente."
      ],
      "style_ref": "legal.body"
    },
    {
      "id": "legal.definition",
      "label": "Definición",
      "description": "Contenido que establece el significado de un término o concepto.",
      "applies_to": [
        "topic"
      ],
      "when_to_use": [
        "La norma define expresamente un término o concepto."
      ],
      "when_not_to_use": [
        "Una explicación contextual que no define."
      ],
      "style_ref": "legal.definition"
    },
    {
      "id": "legal.exception",
      "label": "Excepción",
      "description": "Regla o supuesto que limita el alcance de una regla general.",
      "applies_to": [
        "topic"
      ],
      "when_to_use": [
        "La fuente establece una excepción, salvedad o exclusión normativa."
      ],
      "when_not_to_use": [
        "Una condición ordinaria que forma parte de la regla general."
      ],
      "style_ref": "legal.exception"
    },
    {
      "id": "legal.obligation",
      "label": "Obligación",
      "description": "Mandato que impone una conducta o deber.",
      "applies_to": [
        "topic"
      ],
      "when_to_use": [
        "El texto establece una obligación o deber."
      ],
      "when_not_to_use": [
        "Una recomendación o facultad."
      ],
      "style_ref": "legal.obligation"
    },
    {
      "id": "legal.prohibition",
      "label": "Prohibición",
      "description": "Mandato que impide una conducta.",
      "applies_to": [
        "topic"
      ],
      "when_to_use": [
        "El texto prohíbe expresamente una conducta."
      ],
      "when_not_to_use": [
        "Una obligación positiva."
      ],
      "style_ref": "legal.prohibition"
    },
    {
      "id": "legal.deadline",
      "label": "Plazo",
      "description": "Periodo temporal o fecha límite con relevancia normativa.",
      "applies_to": [
        "topic"
      ],
      "when_to_use": [
        "El plazo aparece expresamente en la fuente."
      ],
      "when_not_to_use": [
        "Una duración inferida o calculada sin respaldo."
      ],
      "style_ref": "legal.deadline"
    },
    {
      "id": "legal.reference",
      "label": "Remisión normativa",
      "description": "Referencia explícita a otro artículo, norma o disposición.",
      "applies_to": [
        "topic"
      ],
      "when_to_use": [
        "El contenido remite a otra disposición."
      ],
      "when_not_to_use": [
        "Una mención incidental sin función de remisión."
      ],
      "style_ref": "legal.reference"
    },
    {
      "id": "table.header_cell",
      "label": "Celda de cabecera",
      "description": "Celda que identifica el nombre, categoría o dimensión de una columna o fila.",
      "applies_to": [
        "topic"
      ],
      "when_to_use": [
        "La estructura de tabla asigna a la celda una función de encabezado."
      ],
      "when_not_to_use": [
        "Una celda de datos destacada solo por su apariencia."
      ],
      "style_ref": "table.header-cell"
    },
    {
      "id": "table.body_cell",
      "label": "Celda de contenido",
      "description": "Celda que contiene el valor, explicación o dato asociado a una cabecera.",
      "applies_to": [
        "topic"
      ],
      "when_to_use": [
        "La celda contiene datos o explicación dentro de una tabla."
      ],
      "when_not_to_use": [
        "Una cabecera o rótulo estructural."
      ],
      "style_ref": "table.body-cell"
    },
    {
      "id": "study.note",
      "label": "Nota de estudio",
      "description": "Aclaración editorial añadida para facilitar el aprendizaje, no perteneciente al texto normativo.",
      "applies_to": [
        "topic"
      ],
      "when_to_use": [
        "El contenido es una explicación, mnemotecnia o aclaración propia."
      ],
      "when_not_to_use": [
        "Texto literal de la norma."
      ],
      "style_ref": "study.note"
    }
