{
  "catalog_version": "1.0.0",
  "catalog_id": "xmind-md.study",
  "title": "Catálogo de estilos para mapas de estudio",
  "description": "Catálogo de referencia PMD para documentación estructurada y legislación. Es una especificación de diseño; no lo consume todavía el resolutor IR 1.x.",
  "defaults": {
    "topic": {
      "text": {
