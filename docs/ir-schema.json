{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PabloGonzalezRuiz/xmind-md/blob/main/docs/ir-schema.json",
  "title": "XMind MD Intermediate Representation",
  "description": "Esquema del contrato IR 1.0.0. La validación estructural se complementa con validaciones semánticas de referencias e IDs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ir_version",
    "id",
    "title",
    "metadata",
    "styles",
    "style_sets",
    "assets",
    "sheet"
  ],
  "properties": {
    "ir_version": {
      "const": "1.0.0"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "styles": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/styleDefinition"
      }
    },
    "style_sets": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/styleSet"
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/asset"
      }
    },
    "sheet": {
      "$ref": "#/$defs/sheet"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "author": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "created": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "modified": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "additionalProperties": true
    },
    "styleState": {
      "type": "object",
      "required": [
        "ref",
        "overrides",
        "resolved"
      ],
      "properties": {
        "ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "style_set": {
          "type": [
            "string",
            "null"
          ]
        },
        "overrides": {
          "type": "object",
          "additionalProperties": true
        },
        "resolved": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "styleDefinition": {
      "type": "object",
      "properties": {
        "topic": {
          "type": "object",
          "additionalProperties": true
        },
        "relationship": {
          "type": "object",
          "additionalProperties": true
        },
        "boundary": {
          "type": "object",
          "additionalProperties": true
        },
        "summary": {
          "type": "object",
          "additionalProperties": true
        },
        "notes": {
          "type": "object",
          "additionalProperties": true
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "styleSet": {
      "type": "object",
      "properties": {
        "topic": {
          "type": "object",
          "additionalProperties": true
        },
        "relationship": {
          "type": "object",
          "additionalProperties": true
        },
        "boundary": {
          "type": "object",
          "additionalProperties": true
        },
        "summary": {
          "type": "object",
          "additionalProperties": true
        },
        "notes": {
          "type": "object",
          "additionalProperties": true
        },
        "styles": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/styleDefinition"
          }
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "properties": {
        "file": {
          "type": [
            "string",
            "null"
          ]
        },
        "line_start": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "line_end": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "markdown_heading": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "run": {
      "type": "object",
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "style": {
          "type": "object",
          "additionalProperties": true
        },
        "link": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "contentBlock": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "text"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "type": {
              "const": "paragraph"
            },
            "text": {
              "type": "string"
            },
            "runs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/run"
              }
            },
            "style": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "type",
            "ordered",
            "items"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "type": {
              "const": "list"
            },
            "ordered": {
              "type": "boolean"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/listItem"
              }
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "type",
            "rows"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "type": {
              "const": "table"
            },
            "columns": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "rows": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/tableRow"
              }
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "type",
            "code"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "type": {
              "const": "code"
            },
            "language": {
              "type": [
                "string",
                "null"
              ]
            },
            "code": {
              "type": "string"
            },
            "caption": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "type",
            "text"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "type": {
              "const": "quote"
            },
            "text": {
              "type": "string"
            },
            "attribution": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "type",
            "expression"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "type": {
              "const": "equation"
            },
            "notation": {
              "type": "string",
              "default": "latex"
            },
            "expression": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "type",
            "asset_id"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "type": {
              "const": "image"
            },
            "asset_id": {
              "$ref": "#/$defs/id"
            },
            "alt": {
              "type": [
                "string",
                "null"
              ]
            },
            "caption": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "type": {
              "const": "divider"
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "type",
            "format",
            "data"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "type": {
              "const": "raw"
            },
            "format": {
              "type": "string"
            },
            "mime_type": {
              "type": [
                "string",
                "null"
              ]
            },
            "data": {}
          },
          "additionalProperties": true
        }
      ]
    },
    "listItem": {
      "type": "object",
      "required": [
        "content",
        "children"
      ],
      "properties": {
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contentBlock"
          }
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/listItem"
          }
        }
      },
      "additionalProperties": true
    },
    "tableRow": {
      "type": "object",
      "required": [
        "cells"
      ],
      "properties": {
        "header": {
          "type": "boolean",
          "default": false
        },
        "cells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tableCell"
          }
        }
      },
      "additionalProperties": true
    },
    "tableCell": {
      "type": "object",
      "required": [
        "content"
      ],
      "properties": {
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contentBlock"
          }
        },
        "colspan": {
          "type": "integer",
          "minimum": 1
        },
        "rowspan": {
          "type": "integer",
          "minimum": 1
        },
        "style": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "note": {
      "type": "object",
      "required": [
        "id",
        "content"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contentBlock"
          }
        },
        "style": {
          "$ref": "#/$defs/styleState"
        }
      },
      "additionalProperties": true
    },
    "annotation": {
      "type": "object",
      "required": [
        "notes",
        "labels",
        "markers",
        "task"
      ],
      "properties": {
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/note"
          }
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "text"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "text": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "markers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "group",
              "value"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "group": {
                "type": "string"
              },
              "value": {
                "type": [
                  "string",
                  "number",
                  "integer",
                  "boolean"
                ]
              }
            },
            "additionalProperties": true
          }
        },
        "task": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "status": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "progress": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 100
                },
                "start_date": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date"
                },
                "due_date": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date"
                },
                "assignee": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": true
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "link": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "target"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "web",
            "topic",
            "file",
            "internal"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "topic": {
      "type": "object",
      "required": [
        "id",
        "title",
        "kind",
        "content",
        "annotations",
        "resources",
        "links",
        "style",
        "layout",
        "extensions",
        "source",
        "children"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "default": "attached"
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contentBlock"
          }
        },
        "annotations": {
          "$ref": "#/$defs/annotation"
        },
        "resources": {
          "type": "object",
          "required": [
            "images",
            "attachments",
            "audio"
          ],
          "properties": {
            "images": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              }
            },
            "attachments": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              }
            },
            "audio": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              }
            }
          },
          "additionalProperties": true
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          }
        },
        "style": {
          "$ref": "#/$defs/styleState"
        },
        "layout": {
          "type": "object",
          "additionalProperties": true
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/topic"
          }
        }
      },
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "required": [
        "kind",
        "path"
      ],
      "properties": {
        "kind": {
          "enum": [
            "image",
            "attachment",
            "audio"
          ]
        },
        "path": {
          "type": "string"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "mime_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "size": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "sheet": {
      "type": "object",
      "required": [
        "id",
        "title",
        "metadata",
        "layout",
        "root_topic",
        "relationships",
        "boundaries",
        "summaries"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        },
        "layout": {
          "type": "object",
          "required": [
            "structure",
            "direction"
          ],
          "properties": {
            "structure": {
              "type": "string"
            },
            "direction": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": true
        },
        "root_topic": {
          "$ref": "#/$defs/topic"
        },
        "relationships": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relationship"
          }
        },
        "boundaries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/boundary"
          }
        },
        "summaries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/summary"
          }
        }
      },
      "additionalProperties": false
    },
    "relationship": {
      "type": "object",
      "required": [
        "id",
        "source_topic",
        "target_topic",
        "title",
        "style",
        "extensions"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "source_topic": {
          "$ref": "#/$defs/id"
        },
        "target_topic": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "style": {
          "$ref": "#/$defs/styleState"
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "boundary": {
      "type": "object",
      "required": [
        "id",
        "topic_ids",
        "title",
        "style",
        "extensions"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "topic_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "style": {
          "$ref": "#/$defs/styleState"
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": [
        "id",
        "topic_ids",
        "title",
        "style",
        "extensions"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "topic_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "style": {
          "$ref": "#/$defs/styleState"
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    }
  }
}
